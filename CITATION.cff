    given-names: Khadim
    affiliation: "Université Cheikh Anta Diop de Dakar, LACGAA"
version: 13.0.0
date-released: "2026-01-01"
license: MIT
repository-code: "https://github.com/Bambiste01/memoire-bruit-intelligent"
keywords:
  - side-channel attack
  - fault injection
  - noise generator
  - AES
  - STM32F3
  - ParEGO
  - embedded AI
